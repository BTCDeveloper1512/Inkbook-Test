ist"], "price_range": "medium", "images": [], "avg_rating": 0.0, "review_count": 0, "created_at": "2026-05-19T17:59:14.388638+00:00", "is_verified": false, "is_active": true, "_id": "6a0ca4f2999ae990640e11fd", "bank_holder": "Ole Hellwig", "bank_iban": "DE62 2805 0100 0090 2566 60", "stripe_connect_account_id": "acct_manual_johannink", "stripe_connect_status": "complete"}, {"studio_id": "studio_53c9d60f1684", "owner_id": "6a0dc995517262e4f1955819", "owner_name": "TestStudio", "name": "TestStudio", "description": "Test", "address": "Testadresse 12", "city": "12345 Teststadt", "country": "DE", "phone": "0161 12345678", "email": "", "website": "", "styles": ["Fine Line", "Portrait", "Realism"], "price_range": "medium", "images": [], "avg_rating": 0.0, "review_count": 0, "created_at": "2026-05-20T14:48:31.959432+00:00", "is_verified": false, "is_active": true, "_id": "6a0dc9bf517262e4f195581a"}], "bookings": [{"booking_id": "book_f8b99b5c7e4a", "user_id": "6a0db15c3caf7e78729301e4", "user_name": "Johann Hellwig", "user_email": "johannhellwig33@gmail.com", "studio_id": "studio_fe27560f7248", "studio_name": "JohannINK", "slot_id": "slot_7ed868879be3", "date": "2026-05-20", "start_time": "15:26", "end_time": "16:26", "booking_type": "tattoo", "notes": "Via Chat gebucht", "reference_images": [], "status": "pending", "payment_status": "unpaid", "deposit_amount": 50.0, "created_at": "2026-05-20T13:27:28.176356+00:00", "_id": "6a0db6c002e3260804607900"}], "slots": [{"slot_id": "slot_734b08053901", "studio_id": "studio_demo001", "date": "2026-05-20", "slot_type": "consultation", "duration_minutes": 30, "start_time": "10:00", "end_time": "10:30", "is_booked": false, "notes": "", "created_at": "2026-05-19T13:24:46.858547+00:00", "_id": "6a0c649e9ccd290e54931fbc"}, {"slot_id": "slot_6c618a1a5ea0", "studio_id": "studio_demo001", "date": "2026-05-20", "slot_type": "tattoo", "duration_minutes": 120, "start_time": "11:00", "end_time": "13:00", "is_booked": false, "notes": "", "created