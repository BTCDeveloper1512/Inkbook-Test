modules = ["nodejs-20", "python-3.12", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["stripe:1.0.0", "resend:1.0.0", "replitmail:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["zip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Mobile"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && yarn install && yarn start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn server:app --host localhost --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "Expo Mobile"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mobile && EXPO_PUBLIC_API_URL=https://90cbaa4c-83f2-48cc-8b6a-12a058981075-00-2g32bywufcl16-76yz87r2.riker.replit.dev npx expo start --port 8081"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5097
externalPort = 3003

[[ports]]
localPort = 5098
externalPort = 3002

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23636
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd backend && uvicorn server:app --host 0.0.0.0 --port 8000 & cd frontend && yarn build && npx serve -s build -l 5000"]
build = ["sh", "-c", "cd frontend && yarn install && yarn build"]

[userenv]

[userenv.shared]
SENDER_EMAIL = "onboarding@resend.dev"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
